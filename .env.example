# PostgreSQL connection string used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign session JWTs (auth). Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-32-bytes-minimum-secret

# Secret used to sign/verify QR pickup tokens. Generate with: openssl rand -hex 32
QR_SIGNING_SECRET=change-me-32-bytes-minimum-secret

# Razorpay (https://dashboard.razorpay.com/app/keys) - required for online payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret configured in Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Public key id exposed to the browser checkout widget (same value as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
